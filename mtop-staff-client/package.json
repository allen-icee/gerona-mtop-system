{
    "name": "mtop-staff-client",
    "version": "1.0.0",
    "description": "Client wrapper for the Gerona MTOP System",
    "author": "Allen",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder"
    },
    "devDependencies": {
        "electron": "^43.0.0",
        "electron-builder": "^26.7.0"
    },
    "build": {
        "appId": "com.gerona.mtopclient",
        "productName": "MTOP Staff Client",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "MunicipalityLogo.png"
        }
    }
}
