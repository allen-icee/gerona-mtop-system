{
    "name": "gerona-mtop-system",
    "version": "1.0.0",
    "description": "Gerona MTOP System",
    "main": "electron.cjs",
    "type": "module",
    "author": "Municipality of Gerona",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "start": "electron electron.cjs",
        "dist": "electron-builder",
        "watch": "concurrently -k \"npm run dev\" \"npm start\""
    },
    "build": {
        "appId": "com.gerona.mtop",
        "productName": "Gerona MTOP System",
        "win": {
            "target": "nsis",
            "icon": "public/images/MunicipalityLogo.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "files": [
            "dist/**/*",
            "public/**/*",
            "resources/**/*",
            "routes/**/*",
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "storage/**/*",
            "vendor/**/*",
            "electron.cjs",
            ".env"
        ],
        "asar": true
    },
    "dependencies": {
        "react-hot-toast": "^2.4.1"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@iconify-json/iconamoon": "^1.2.2",
        "@iconify-json/solar": "^1.2.5",
        "@iconify/react": "^4.1.1",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^20.0.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.6.0",
        "concurrently": "^9.0.1",
        "electron": "^25.9.8",
        "electron-builder": "^26.7.0",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.31",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.2",
        "vite": "^5.0.0"
    }
}
